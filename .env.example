# Copy to .env.local and fill in. Never commit real values.

# --- Claude -------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. claude-sonnet-5-5 is roughly half the cost.
CLAUDE_MODEL=

# --- Database -----------------------------------------------------------
# Neon Postgres connection string (pooled). Leave EMPTY for local dev: the app
# then uses an embedded PGlite database stored in .data/pglite.
DATABASE_URL=

# --- File storage (PDF uploads) ----------------------------------------
# Vercel Blob read/write token. Needed for the PDF upload flow in production.
BLOB_READ_WRITE_TOKEN=

# --- Auth ---------------------------------------------------------------
# Single shared passphrase that protects the whole app, plus a long random
# string used to sign the session cookie (e.g. `openssl rand -base64 48`).
# In development, leaving APP_PASSWORD empty disables the login gate.
APP_PASSWORD=
SESSION_SECRET=

# --- Dev/testing only ---------------------------------------------------
# Set to 1 to generate fake cards instead of calling Claude (no API cost).
MOCK_LLM=
